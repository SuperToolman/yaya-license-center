{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "tests/**/*.ts",
    "playwright.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-test/types/**/*.ts",
    ".next-test/dev/types/**/*.ts",
    ".next-test\\dev/types/**/*.ts",
    ".next-test\\dev/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next\\dev/types/**/*.ts",
    ".next\\dev/types/**/*.ts",
    ".next-offline-e2e\\dev/types/**/*.ts",
    ".next-offline-e2e\\dev/types/**/*.ts",
    ".next-upload-check\\dev/types/**/*.ts",
    ".next-upload-check\\dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".patches"
  ]
}
