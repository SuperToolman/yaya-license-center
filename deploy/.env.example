# Legacy Docker deployment only. Native publishing uses shared/operation-center.env.
CONTAINER_NAME=yaya-operation-center
WEB_PORT=8778
API_PORT=8779
# 客户容器可访问的运营平台 API 地址，用于许可证状态确认和激活。
# Docker 部署默认使用 host.docker.internal 与映射的 API_PORT。
# 可改为实际的 HTTPS API 域名，例如 https://operation-api.example.com。
YAYA_PLATFORM_LICENSE_CENTER_URL=
# 生产环境运营管理台的公开来源，用于过滤管理台自身产生的审计请求。
WEB_ORIGIN=https://operation.example.com
# 可替换为企业内部 Cargo 镜像；默认使用 rsproxy 稀疏索引。
CARGO_REGISTRIES_CRATES_IO_INDEX=sparse+https://rsproxy.cn/index/

# 官网客户手机号注册/登录：与低代码平台使用相同的阿里云短信参数。
# 短信模板应注明验证码有效期 1 分钟；密钥仅由 API 服务使用。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_LOGIN_TEMPLATE_CODE=
ALIYUN_SMS_CODE_PARAM=code
ALIYUN_SMS_REGION=cn-hangzhou
