# The publish script writes CONTAINER_NAME automatically.
CONTAINER_NAME=yaya-operation-center
WEB_PORT=8778
API_PORT=8779
# 生产环境运营管理台的公开来源，用于过滤管理台自身产生的审计请求。
WEB_ORIGIN=https://operation.example.com
# 可替换为企业内部 Cargo 镜像；默认使用 rsproxy 稀疏索引。
CARGO_REGISTRIES_CRATES_IO_INDEX=sparse+https://rsproxy.cn/index/
