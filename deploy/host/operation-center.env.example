# Optional settings. The installer writes managed ports/paths and service UID.
# Copy selected entries into shared/operation-center.env on the host.
YAYA_OPERATION_CENTER_INITIAL_ADMIN_USERNAME="admin"
ALIYUN_ACCESS_KEY_ID=""
ALIYUN_ACCESS_KEY_SECRET=""
ALIYUN_SMS_SIGN_NAME=""
ALIYUN_SMS_LOGIN_TEMPLATE_CODE=""
ALIYUN_SMS_CODE_PARAM="code"
ALIYUN_SMS_REGION="cn-hangzhou"
# Optional current-environment file management root. Empty uses / on Linux.
YAYA_FILES_ROOT="/"
